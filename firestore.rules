rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'ADMIN' || 
        getUserData().role == 'admin'
      );
    }

    // Default Rule: Deny all unauthenticated/unmatched access
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection Access Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.auth.uid == userId || 
        !request.resource.data.keys().hasAny(['role']) || 
        request.resource.data.role == 'PATIENT' || 
        isAdmin()
      );
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Appointments Collection Access Rules
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Audit Logs & System Collections (Admin Read/Write Only)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
